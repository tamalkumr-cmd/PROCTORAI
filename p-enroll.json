{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],
     "Resource":"arn:aws:logs:ap-south-1:582093723182:*"},
    {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:UpdateItem"],
     "Resource":"arn:aws:dynamodb:ap-south-1:582093723182:table/Students"},
    {"Effect":"Allow","Action":["s3:PutObject"],
     "Resource":"arn:aws:s3:::proctorai-media-tamal/baselines/*"},
