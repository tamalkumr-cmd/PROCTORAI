{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],
     "Resource":"arn:aws:logs:ap-south-1:582093723182:*"},
    {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:PutItem","dynamodb:UpdateItem","dynamodb:Scan"],
     "Resource":"arn:aws:dynamodb:ap-south-1:582093723182:table/Exams"},
    {"Effect":"Allow","Action":["dynamodb:Scan"],
     "Resource":"arn:aws:dynamodb:ap-south-1:582093723182:table/ExamSessions"}
  ]
}
