{
  "Version": "2012-10-17",
  "Statement": [
    {"Effect":"Allow","Action":["logs:CreateLogGroup","logs:CreateLogStream","logs:PutLogEvents"],
     "Resource":"arn:aws:logs:ap-south-1:582093723182:*"},
    {"Effect":"Allow","Action":["dynamodb:GetItem","dynamodb:Query","dynamodb:Scan"],
     "Resource":["arn:aws:dynamodb:ap-south-1:582093723182:table/ExamSessions",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/RiskScores",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/FlaggedEvents",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/Students",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/Exams"]},
    {"Effect":"Allow","Action":["dynamodb:UpdateItem"],
     "Resource":["arn:aws:dynamodb:ap-south-1:582093723182:table/ExamSessions",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/FlaggedEvents",
                 "arn:aws:dynamodb:ap-south-1:582093723182:table/Exams"]},
    {"Effect":"Allow","Action":["s3:GetObject"],
     "Resource":"arn:aws:s3:::proctorai-media-tamal/flagged/*"}
  ]
}
